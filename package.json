{
  "name": "canlander-org",
  "version": "1.0.0",
  "private": true,
  "description": "canlander.org: a community guide to Canadian Highlander, the 100-card singleton Magic: The Gathering format.",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve --port=8080",
    "build": "eleventy",
    "decks": "node scripts/build-decks.mjs",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8"
  }
}
