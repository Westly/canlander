// Cloudflare Workers (static assets) config for canlander.org.
// Cloudflare builds the site with `npm run build`, then serves the _site folder.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canlander",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./_site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
