{%- set nav = [
  { url: "/learn/", label: "Learn" },
  { url: "/build/", label: "Build" },
  { url: "/decks/", label: "Decks" },
  { url: "/play/", label: "Play" },
  { url: "/story/", label: "Story" },
  { url: "/council/", label: "Council" },
  { url: "/resources/", label: "Resources" }
] -%}
<header class="masthead">
  <div class="wrap masthead__inner">
    <a class="brand" href="/" aria-label="Canlander home">
      {% include "partials/mark.njk" %}
      <span class="brand__word">Canlander<span class="brand__tld">.org</span></span>
    </a>
    <nav class="nav" aria-label="Primary">
      <ul>
        {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
      <a class="nav__cta" href="{{ site.discord }}">Discord <span aria-hidden="true">↗</span></a>
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="menu-toggle__label">Menu</span>
    </button>
  </div>
  <div class="mobile-nav" id="mobile-nav" hidden>
    <ul>
      {%- for item in nav %}
      <li><a href="{{ item.url }}">{{ item.label }}</a></li>
      {%- endfor %}
      <li><a href="/news/">News</a></li>
      <li><a href="{{ site.discord }}">Discord ↗</a></li>
    </ul>
  </div>
</header>
