---
layout: layouts/base.njk
title: News
seoTitle: "Canadian Highlander news and points updates · Canlander"
description: Points updates, format news, and notes for Canadian Highlander players.
pageClass: news
permalink: /news/
---
<header class="page-head">
  <div class="wrap">
    <p class="eyebrow">News</p>
    <h1 class="page-head__title">News</h1>
    <p class="page-head__lede">Points updates in plain language, with a link to the council's full reasoning every time. <a href="/feed.xml">RSS</a> if you like that sort of thing.</p>
  </div>
</header>

<div class="wrap">
  <ol class="newslist">
    {%- for post in collections.news %}
    <li class="newslist__item">
      <time class="newslist__date" datetime="{{ post.date | isoDate }}">
        <span class="mono">{{ post.date | shortDate }}</span>
        <span class="newslist__year mono">{{ post.date | year }}</span>
      </time>
      <div class="newslist__body">
        {%- if post.data.kind %}<p class="tag">{{ post.data.kind }}</p>{% endif %}
        <h2 class="newslist__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        <p class="newslist__dek">{{ post.data.dek }}</p>
      </div>
    </li>
    {%- endfor %}
  </ol>
</div>
